{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "command -v bd >/dev/null 2>&1 && bd --sandbox prime || cat .beads/PRIME.md 2>/dev/null",
            "type": "command"
          }
        ],
        "matcher": "manual"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash -c 'cd \"$CLAUDE_PROJECT_DIR\" || exit 0; bash scripts/session-freshness-gate.sh || true; [ -f .beads/heal-dolt.sh ] && bash .beads/heal-dolt.sh .beads 2>&1 || true; bd --sandbox stats 2>/dev/null | head -1 || echo \"beads: Dolt unavailable, JSONL backup is source of truth\"; bash scripts/beads-sync-guard.sh'",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "command -v bd >/dev/null 2>&1 && bd --sandbox prime || cat .beads/PRIME.md 2>/dev/null",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/gen-skill-prefix-table.py >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/skill-prefix-router-hook.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Write(.claude/agents/**)",
      "Write(.claude/flux-gen-specs/**)",
      "Write(docs/research/flux-drive/**)",
      "Write(docs/research/flux-research/**)",
      "Write(docs/research/flux-review/**)",
      "Write(**/.claude/agents/**)",
      "Write(**/.claude/flux-gen-specs/**)",
      "Write(**/docs/research/flux-drive/**)",
      "Write(**/docs/research/flux-research/**)",
      "Write(**/docs/research/flux-review/**)",
      "Write(//home/mk/projects/Sylveste/.claude/agents/**)",
      "Write(//home/mk/projects/Sylveste/.claude/flux-gen-specs/**)",
      "Write(//home/mk/projects/Sylveste/docs/research/flux-drive/**)",
      "Write(//home/mk/projects/Sylveste/docs/research/flux-research/**)",
      "Write(//home/mk/projects/Sylveste/docs/research/flux-review/**)",
      "Bash(python3 */generate-agents.py*)",
      "Bash(python3 */flux-agent.py*)"
    ]
  }
}
