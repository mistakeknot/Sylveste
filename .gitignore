# Sylveste monorepo .gitignore
# Each subproject has its own .git — ignore them all here.
# Only the monorepo skeleton, beads, and shared docs are tracked.

# ── Subproject directories (each has its own repo) ──
apps/
os/
core/
interverse/
sdk/*

# ── Beads runtime artifacts (beads' own .gitignore handles the rest) ──
.beads/bd.sock.startlock
.beads/daemon-error
.beads/push-hook.log

# ── Claude Code session artifacts ──
.claude/settings.local.json
.claude/*.log
.claude/worktrees/

# ── Flux agent registry ──
# Generated agents are gitignored by default. Promoted agents (used/proven)
# are force-added with `git add -f`. The index is always a rebuildable cache.
.claude/agents/fd-*.md
.claude/agents/.index.yaml
# Flux-gen spec files (generated per-review, not tracked)
.claude/flux-gen-specs/

# ── Local tool caches ──
.tmp/

# ── Interfluence local learnings log ──
.interfluence/learnings-raw.log

# ── Stale symlinks ──
docs/docs

# ── Clavain ephemeral data ──
.clavain/scratch/
.clavain/verdicts/
.clavain/quality-gates/
.clavain/reviews/
.clavain/checkpoint.json
.clavain/routing-decisions.jsonl
.clavain/gate-tier-calibration.json
.clavain/intercore.db
.clavain/intercore.db.backup-*

# Authz signing keys — private ONLY; pubkey is intentionally committed for verifiers.
.clavain/keys/*.key
.clavain/keys/*.archive
!.clavain/keys/*.pub

# bv (beads viewer) local config and caches
.bv/

# ── Interwatch drift state (runtime, not committed) ──
# watchables.yaml is tracked (project config); drift/history state is not
.interwatch/*
!.interwatch/watchables.yaml

# ── Intermem state (per-project, not committed) ──
.intermem/

# ── interlore scan state (per-project, not committed) ──
.interlore/

# ── Lattice harvest cache (per-project, not committed) ──
.lattice/

# ── Generated secret scan artifacts (reports/logs) ──
docs/reports/security/secret-scan-backfill-*/
docs/reports/security/secret-scan-backfill-*.md

# ── Nested repos (own remotes, not submodules) ──
masaq/

# ── Research clones (not part of monorepo) ──
research/*
!research/AGENTS.md
!research/REPO_INDEX.md
docs/research/*/
!docs/research/dialectics/
!docs/research/flux-drive/
!docs/research/flux-melange/
!docs/research/flux-research/
!docs/research/flux-review/
!docs/research/f1-cypher-benchmark/
!docs/research/f6-ab-corpus/

# Dolt database files (added by bd init)
.dolt/
*.db
.interkasten.yaml

# Beads / Dolt files (added by bd init)
.beads-credential-key
.beads/dolt/

# Per-machine tool state (added 2026-04-19)
.beads/remote/
.claude/projects/
.claude/scheduled_tasks.lock
.claude/session-state.json
.clavain/cxdb/
.clavain/intercept/
# interspect's local instrument store. evidence.db/interspect.db are already
# covered by .clavain/**/*.db, but delegation-calibration.json is not, and one
# unignored generated file is enough to leave the whole directory untracked --
# which is how this repo showed up as "needs a human" with nothing in it a human
# should decide. Same class as .clavain/gate-tier-calibration.json above.
.clavain/interspect/
.clavain/**/*.db
.clavain/**/*.db-shm
.clavain/**/*.db-wal
.codex

# Keep local Interstat/session data ignored while publishing OYRF's public CSV.
data/*
!data/cost-trajectory.csv

# interspect-audit reports are durable research evidence (spike reports +
# quarterly calibration audits), exempt from the local-only research-subdir rule
!docs/research/interspect-audit/
!docs/research/interspect-audit/**
# bd worktree
n2ma-bdtest/
# bd worktree
n2ma-redirect-test-18358/
# bd worktree
n2ma-redirect-test-18879/
# bd worktree
n2ma-redirect-test-19575/
# bd worktree
n2ma-redirect-test-69698/
# bd worktree
n2ma-redirect-test-69998/
# bd worktree
n2ma-redirect-test-70291/

# Editor/OS and Python bytecode noise. These recur constantly and made
# `git status` unreadable in this monorepo, which is how .DS_Store came to be
# tracked in the first place.
.DS_Store
**/.DS_Store
__pycache__/
*.py[cod]

# Advisory lock files from flux-drive/flux-melange runs. Transient by nature:
# the owning process is gone, so a stale one only misleads a future run.
*.jsonl.lock
