#!/bin/bash
# git-internal: the private overlay helper (plan §1.4 P8, P9 and "Private
# sync"). Ships in PR 1 as scripts/git-internal, with its hook templates and
# the approved-path list in scripts/git-internal-hooks/. The private repo's
# git dir is <root>/.git-internal with core.worktree .. and no core.hooksPath.
#
#   git-internal [-C ROOT] install URL HOST   P8: clone, bind, hooks, absent-only checkout
#   git-internal [-C ROOT] install-hooks      copy the hook templates into $GIT_DIR/hooks
#   git-internal [-C ROOT] add PATH...        stage approved, root-relative paths (add -f)
#   git-internal [-C ROOT] commit -m MSG
#   git-internal [-C ROOT] sync               merge main and the other lanes, install, push own lane
#   git-internal [-C ROOT] resolve REF        after exit 3: merge REF using the resolved files on disk
#   git-internal [-C ROOT] probe              P9 binding check with a synthetic commit
#   git-internal [-C ROOT] status|log|diff|show|ls-files|ls-tree|rev-parse|fetch ARGS
#
# Exit codes: 0 ok; 1 usage or refused; 2 clone or fetch failed; 3 conflict,
# nothing written; 4 precondition (detached, staged or local edits to a path
# the sync changes), nothing written; 5 an incoming path exists on disk,
# nothing written; 6 install failed part way (see message); 7 lane push
# failed; 8 probe failed.
set -u
PATH=/usr/local/bin:/usr/bin:/bin
TPL=$(cd "$(dirname "$0")" && pwd -P)/git-internal-hooks

die() { local rc=$1; shift; echo "git-internal: $*" >&2; exit "$rc"; }

ROOT=${GIT_INTERNAL_ROOT:-}
if [ "${1:-}" = -C ]; then ROOT=${2:?}; shift 2; fi
cmd=${1:-}; [ $# -gt 0 ] && shift
if [ -z "$ROOT" ]; then
  ROOT=$PWD; while [ "$ROOT" != / ] && [ ! -d "$ROOT/.git-internal" ]; do ROOT=$(dirname "$ROOT"); done
  [ -d "$ROOT/.git-internal" ] || [ "$cmd" = install ] || die 1 "no .git-internal above $PWD; use -C ROOT"
  [ -d "$ROOT/.git-internal" ] || ROOT=$PWD
fi
ROOT=$(cd "$ROOT" && pwd -P) || die 1 "bad root"
GD=$ROOT/.git-internal
gi() { git -C "$ROOT" --git-dir="$GD" "$@"; }
host() { local h; h=$(cat "$GD/info/host" 2>/dev/null); [ -n "$h" ] || die 4 "$GD/info/host is missing"; printf '%s' "$h"; }

approved() {  # path : 0 if on info/approved-paths
  local p=$1 a
  while IFS= read -r a; do
    case $a in
      ''|'#'*) ;;
      */) [[ $p == "$a"* ]] && return 0 ;;
      *)  [[ $p == "$a" ]] && return 0 ;;
    esac
  done < "$GD/info/approved-paths"
  return 1
}

cmd_install_hooks() {
  [ -d "$GD" ] || die 1 "install-hooks: no $GD"
  mkdir -p "$GD/hooks"
  for h in pre-commit pre-push; do   # PR 2a adds post-merge and post-rewrite (the importer)
    cp "$TPL/$h" "$GD/hooks/$h" && chmod 0755 "$GD/hooks/$h" || die 1 "install-hooks: cannot install $h"
  done
  (cd "$GD/hooks" && sha256sum pre-commit pre-push) > "$GD/info/hooks.sha256"
}

cmd_install() {
  [ $# = 2 ] || die 1 "usage: install URL HOST"
  [ ! -e "$GD" ] || die 4 "install: $GD already exists"
  git clone -q --bare "$1" "$GD" || die 2 "install: clone failed"
  gi config core.bare false
  gi config core.worktree ..
  gi config status.showUntrackedFiles no
  gi config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  printf '%s\n' "$2" > "$GD/info/host"
  [ -e "$GD/info/approved-paths" ] || cp "$TPL/approved-paths" "$GD/info/approved-paths"
  cmd_install_hooks                       # before any commit, sync or probe can run
  gi fetch -q origin || die 2 "install: fetch failed"
  gi reset -q                             # mixed: writes only .git-internal/index
  local p present=()
  while IFS= read -r -d '' p; do
    { [ -e "$ROOT/$p" ] || [ -L "$ROOT/$p" ]; } && present+=("$p")
  done < <(gi ls-files -z)
  [ ${#present[@]} = 0 ] || { printf 'git-internal: install: exists, not overwritten: %s\n' "${present[@]}" >&2; exit 5; }
  gi checkout-index -a || die 5 "install: checkout-index refused an existing path"   # no -f: absent only
}

cmd_add() {
  [ $# -gt 0 ] || die 1 "usage: add PATH..."
  local p
  for p; do
    case $p in -*|.|./|/*|*..*) die 1 "add: '$p' refused: no options, no '.', root-relative paths only" ;; esac
    approved "$p" || die 1 "add: '$p' is not an approved path"
  done
  gi add -f -- "$@"   # -f only here: approved paths are gitignored by the public .gitignore
}

cmd_commit() {
  [ $# = 2 ] && [ "$1" = -m ] || die 1 "usage: commit -m MSG (no -a, no paths, no --no-verify)"
  gi commit -q -m "$2"
}

precheck() {  # the private checkout must be on a branch, with nothing staged
  gi symbolic-ref -q HEAD >/dev/null || die 4 "HEAD is detached"
  local f; for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    [ ! -e "$GD/$f" ] || die 4 "$f is present"
  done
  [ -z "$(gi ls-files -u)" ] || die 4 "unmerged index entries"
  gi update-index -q --refresh >/dev/null || true
  gi diff --cached --quiet || die 4 "staged changes: commit them first"
}

push_lane() { gi push -q origin "HEAD:refs/heads/autosync/$(host)" || die 7 "push of own lane failed"; }

same_blob() {  # rev path : 0 if the file on disk already has that blob's bytes
  [ -f "$ROOT/$2" ] && [ ! -L "$ROOT/$2" ] && [ "$(gi hash-object -- "$ROOT/$2")" = "$(gi rev-parse -q --verify "$1:$2")" ]
}

# install OLD -> NEW into the worktree, fail closed, then move HEAD.
# Every check runs before the first write; nothing is written on refusal.
apply() {
  local old=$1 new=$2 st p d
  local -a A=() M=() D=() W=() bad=() hit=() made=()
  while IFS= read -r -d '' st && IFS= read -r -d '' p; do
    case $st in A) A+=("$p") ;; D) D+=("$p") ;; *) M+=("$p") ;; esac
  done < <(gi diff --no-renames --name-status -z "$old" "$new")
  # 1. tracked paths that change must carry no local edit (or already hold the result)
  for p in "${M[@]}"; do
    same_blob "$new" "$p" && continue
    gi diff --quiet -- "$p" || bad+=("$p")
    W+=("$p")
  done
  for p in "${D[@]}"; do
    { [ -e "$ROOT/$p" ] || [ -L "$ROOT/$p" ]; } || continue
    gi diff --quiet -- "$p" || bad+=("$p")
  done
  [ ${#bad[@]} = 0 ] || { printf 'git-internal: local edit to %s would be replaced; commit or move it. Nothing written.\n' "${bad[@]}" >&2; return 4; }
  # 2. collision: an added path must be absent on disk, ignored and untracked files
  #    included; no leading component may be a file or a symlink
  local -a A2=()
  for p in "${A[@]}"; do
    if same_blob "$new" "$p"; then continue; fi
    if [ -e "$ROOT/$p" ] || [ -L "$ROOT/$p" ]; then hit+=("$p"); continue; fi
    d=$(dirname "$p")
    while [ "$d" != . ]; do
      if [ -L "$ROOT/$d" ] || { [ -e "$ROOT/$d" ] && [ ! -d "$ROOT/$d" ]; }; then hit+=("$p"); break; fi
      d=$(dirname "$d")
    done
    A2+=("$p")
  done
  if [ ${#hit[@]} -gt 0 ]; then
    printf 'git-internal: incoming path exists on disk, not overwritten: %s\n' "${hit[@]}" >&2
    gi ls-files -o -i --exclude-standard -- "${hit[@]}" | sed 's/^/git-internal:   (gitignored) /' >&2
    echo "git-internal: move it aside or delete it (owner's call), then sync again. Nothing written." >&2
    return 5
  fi
  # 3. install. checkout-index without -f creates added files exclusively and
  #    refuses one that appeared since step 2; then this run's own files are removed.
  local idx="$GD/sync-index.$$"
  GIT_INDEX_FILE=$idx gi read-tree "$new" || { rm -f "$idx"; return 6; }
  for p in "${A2[@]}"; do
    if GIT_INDEX_FILE=$idx gi checkout-index -- "$p"; then made+=("$p"); else
      for d in "${made[@]}"; do rm -f -- "$ROOT/$d"; done; rm -f "$idx"
      echo "git-internal: $p appeared during the install; this run's new files removed. Nothing else written." >&2
      return 5
    fi
  done
  if [ ${#W[@]} -gt 0 ]; then
    GIT_INDEX_FILE=$idx gi checkout-index -f -- "${W[@]}" || { rm -f "$idx"; echo "git-internal: install failed part way; HEAD not moved" >&2; return 6; }
  fi
  for p in "${D[@]}"; do rm -f -- "$ROOT/$p"; done
  rm -f "$idx"
  gi read-tree "$new" || return 6          # the index was HEAD (precheck), so nothing staged is lost
  gi update-index -q --refresh >/dev/null || true
  gi update-ref -m "git-internal sync" HEAD "$new" "$old" || { echo "git-internal: HEAD moved during sync" >&2; return 6; }
  gi update-ref ORIG_HEAD "$old"           # the importer reads ORIG_HEAD..HEAD, as after a merge
  # read-tree fires no hook, so run post-merge here (PR 2a: the importer)
  if [ -x "$GD/hooks/post-merge" ]; then
    (cd "$ROOT" && GIT_DIR=$GD "$GD/hooks/post-merge" 0) || echo "git-internal: post-merge hook failed" >&2
  fi
}

# fold main and every other lane into one commit, in objects only
cmd_sync() {
  [ $# = 0 ] || die 1 "usage: sync"
  local h old cur ref out rc
  h=$(host); precheck
  gi fetch -q origin || die 2 "fetch failed"
  old=$(gi rev-parse HEAD); cur=$old
  for ref in $(gi for-each-ref --format='%(refname)' refs/remotes/origin/main refs/remotes/origin/autosync); do
    [ "$ref" = "refs/remotes/origin/autosync/$h" ] && continue
    gi merge-base --is-ancestor "$ref" "$cur" && continue
    if gi merge-base --is-ancestor "$cur" "$ref"; then cur=$(gi rev-parse "$ref^{commit}"); continue; fi
    out=$(gi merge-tree --write-tree --name-only "$cur" "$ref"); rc=$?
    if [ $rc = 1 ]; then
      echo "git-internal: sync: ${ref#refs/remotes/} conflicts. Nothing written. Conflicted paths:" >&2
      printf '%s\n' "$out" | sed -n '2,/^$/p' | sed '/^$/d; s/^/  /' >&2
      echo "git-internal: write the resolved files, then: git-internal resolve ${ref#refs/remotes/}" >&2
      exit 3
    fi
    [ $rc = 0 ] || die 6 "merge-tree failed ($rc)"
    cur=$(gi commit-tree "${out%%$'\n'*}" -p "$cur" -p "$ref" -m "git-internal sync: merge ${ref#refs/remotes/}") || die 6 "commit-tree failed"
  done
  if [ "$cur" != "$old" ]; then apply "$old" "$cur" || exit $?; fi
  push_lane
}

# after exit 3: merge REF, taking each conflicted path from disk (resolved by the session)
cmd_resolve() {
  [ $# = 1 ] || die 1 "usage: resolve REF"
  local old ref out rc tree p mode blob new idx
  host >/dev/null; precheck
  ref=$(gi rev-parse -q --verify "$1^{commit}") || die 1 "resolve: unknown ref $1"
  old=$(gi rev-parse HEAD)
  out=$(gi merge-tree --write-tree --name-only "$old" "$ref"); rc=$?
  [ $rc = 1 ] || die 1 "resolve: $1 does not conflict with HEAD; run sync"
  tree=${out%%$'\n'*}
  idx="$GD/resolve-index.$$"
  GIT_INDEX_FILE=$idx gi read-tree "$tree" || die 6 "resolve: read-tree failed"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    approved "$p" || { rm -f "$idx"; die 1 "resolve: $p is not an approved path"; }
    if [ -f "$ROOT/$p" ]; then
      grep -qE '^(<<<<<<<|>>>>>>>) ' "$ROOT/$p" && { rm -f "$idx"; die 1 "resolve: $p still has conflict markers"; }
      mode=$(gi ls-tree "$tree" -- "$p" | cut -d' ' -f1); [ -n "$mode" ] || mode=100644
      blob=$(gi hash-object -w -- "$ROOT/$p")
      GIT_INDEX_FILE=$idx gi update-index --add --cacheinfo "$mode,$blob,$p"
    else
      GIT_INDEX_FILE=$idx gi update-index --force-remove -- "$p"
    fi
  done < <(printf '%s\n' "$out" | sed -n '2,/^$/p')
  tree=$(GIT_INDEX_FILE=$idx gi write-tree); rm -f "$idx"
  new=$(gi commit-tree "$tree" -p "$old" -p "$ref" -m "git-internal resolve: merge $1") || die 6 "commit-tree failed"
  apply "$old" "$new" || exit $?
  push_lane
}

# P9 binding check, from a cwd outside the root, with a synthetic commit so the
# dry-run push to main always carries an update and the hook always runs
cmd_probe() {
  [ $# = 0 ] || die 1 "usage: probe"
  local h fails=0 p err
  h=$(host); cd / || exit 8
  g() { git --git-dir="$GD" "$@"; }
  bad() { echo "git-internal: probe: $*" >&2; fails=$((fails+1)); }
  [ "$(g rev-parse --show-toplevel)" = "$ROOT" ] || bad "toplevel is not $ROOT"
  [ "$(g rev-parse --git-path hooks)" = "$GD/hooks" ] || bad "hooks do not resolve to $GD/hooks"
  [ -z "$(g config --get core.hooksPath)" ] || bad "core.hooksPath is set"
  [ "$(g config --get core.worktree)" = .. ] || bad "core.worktree is not .."
  (cd "$GD/hooks" && sha256sum --quiet -c ../info/hooks.sha256) >/dev/null 2>&1 || bad "installed hooks differ from info/hooks.sha256"
  p=$(g commit-tree "HEAD^{tree}" -p HEAD -m "git-internal probe (never pushed)") || bad "cannot build the probe commit"
  err=$(g push --dry-run origin "$p:refs/heads/main" 2>&1) && bad "dry-run push of a new commit to main was NOT refused"
  [[ $err == *"private pre-push: only refs/heads/autosync/$h"* ]] || bad "main refusal did not come from the private pre-push hook"
  g push -q --dry-run origin "$p:refs/heads/autosync/$h" >/dev/null 2>&1 || bad "positive control: dry-run push to own lane failed"
  [ $fails = 0 ] || exit 8
  echo "git-internal: probe ok ($ROOT, lane autosync/$h)"
}

case $cmd in
  install) cmd_install "$@" ;;
  install-hooks) cmd_install_hooks "$@" ;;
  add) cmd_add "$@" ;;
  commit) cmd_commit "$@" ;;
  sync) cmd_sync "$@" ;;
  resolve) cmd_resolve "$@" ;;
  probe) cmd_probe "$@" ;;
  status|log|diff|show|ls-files|ls-tree|rev-parse|fetch) gi "$cmd" "$@" ;;
  *) die 1 "usage: git-internal [-C ROOT] install|install-hooks|add|commit|sync|resolve|probe|status|log|diff|show|ls-files|ls-tree|rev-parse|fetch" ;;
esac
