# Dolt database (managed by Dolt, not git)
dolt/
embeddeddolt/
dolt-access.lock

# Dolt federation remote (legacy `beads_iv` DB from pre-2026-03-15 migration —
# runtime artifacts, not source. ~138 MB. See .beads/pull.sh comment.)
remote/

# Historical JSONL/DB snapshots from past migrations (~9 MB combined).
# .bak is current bd's auto-rotation; backup-* are one-time migration
# breadcrumbs. Source of truth lives in issues.jsonl (and Dolt).
issues.jsonl.bak
issues.jsonl.backup-*
config.yaml.backup-*
beads.db.migrated

# Runtime files
bd.sock
bd.sock.startlock
sync-state.json
last-touched
.exclusive-lock

# Daemon runtime (lock, log, pid)
daemon.*

# Interactions log (runtime, not versioned)
interactions.jsonl

# Push state (runtime, per-machine)
push-state.json

# Lock files (various runtime locks)
*.lock

# Credential key (encryption key for federation peer auth — never commit)
.beads-credential-key

# Local version tracking (prevents upgrade notification spam after git ops)
.local_version

# Worktree redirect file (contains relative path to main repo's .beads/)
# Must not be committed as paths would be wrong in other clones
redirect

# Sync state (local-only, per-machine)
# These files are machine-specific and should not be shared across clones
.sync.lock
export-state.json
export-state/

# Ephemeral store (SQLite - wisps/molecules, intentionally not versioned)
ephemeral.sqlite3
ephemeral.sqlite3-journal
ephemeral.sqlite3-wal
ephemeral.sqlite3-shm

# Dolt server management (auto-started by bd)
dolt-server.pid
dolt-server.log
dolt-server.lock
dolt-server.port
dolt-server.activity

# Corrupt backup directories (created by bd doctor --fix recovery)
*.corrupt.backup/

# Backup data (auto-exported JSONL, local-only)
backup/

# Per-project environment file (Dolt connection config, GH#2520)
.env

# Legacy files (from pre-Dolt versions)
*.db
*.db?*
*.db-journal
*.db-wal
*.db-shm
db.sqlite
bd.db
# NOTE: Do NOT add negation patterns here.
# They would override fork protection in .git/info/exclude.
# config.yaml is tracked by git: it configures the PROJECT, and both machines
# should agree on it. metadata.json is not — see below.

# Machine-local: names which database THIS checkout talks to.
#
# dolt_mode, dolt_database and dolt_server_port are properties of the machine,
# not of the project, and a tracked file is a channel between machines. zklw
# carried Clavain's port 57745 for months while actually serving on 42527 from
# its own untracked .beads/dolt-server.port — a wrong value sitting in a shared
# file, inert only because no bd version happened to honour it. bd itself says
# "Remove dolt_server_port from .beads/metadata.json to silence this warning"
# and flags the field as cross-project data leakage (GH#2372).
#
# The demonstrated failure is worse than a stale port: `bd init` makes its own
# git commit, so a second init propagates its database identity to the other
# machine on the next pull. In the two-machine sandbox for Sylveste-n6xc that
# collapsed both repos onto one database while every isolation check still
# passed, because each was checking its own .beads/ path rather than the
# database behind it. `git update-index --skip-worktree` did not survive it.
#
# Cost of untracking: a fresh clone has no metadata.json and needs `bd bootstrap`
# (or `bd init`) before `bd import .beads/issues.jsonl`. Covered by
# tests/test_beads_metadata_isolation.sh scenario 4.
metadata.json

# Auto-export hook diagnostics (machine-local)
auto-export.log
